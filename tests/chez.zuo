#lang zuo

(require "../zuokit.zuo")

(define args (hash-ref (runtime-env) 'args))
(define scheme (if (null? args) "scheme" (car args)))
(define time (current-time))
(define base (build-path (hash-ref (runtime-env) 'dir) "build" (~a "chez test 中文-" (car time) "-" (cdr time))))
(define src (build-path base "source"))
(define out (build-path base "objects"))
(define extra (build-path base "dependency/support.ss"))
(define input (build-path base "support.ss.in"))
(define z (build-path src "demo/z.ss"))
(define added (build-path src "demo/added.sls"))
(define (check v message) (unless v (error message)))
(define (put p text) (mkdir-p (path-only p)) (display-to-file text p :truncate))
(define (library name export value)
  (list 'library name (list 'export export) '(import (chezscheme)) (list 'define export value)))
(define (stamp p)
  (define s (stat p))
  (list (hash-ref s 'modify-time-seconds) (hash-ref s 'modify-time-nanoseconds)))
(put (build-path src "demo.ss") "(error 'test \"program selected instead of library\")\n")
(write-forms (build-path src "demo.sls")
  '((library (demo) (export value) (import (chezscheme) (demo z) (support)) (define value (+ z extra)))))
(write-forms z (list (library '(demo z) 'z 7)))
(put (build-path src "options.txt") "one")
(write-forms input (list (library '(support) 'extra 5)))
(define dependency (step extra (list input) (lambda () (cp* input extra)) 'db-dir base))
(define (project level)
  (chez-project '("demo.sls" "demo") out 'base src 'scheme scheme 'args '("-q")
                'library-dirs (list (path-only extra)) 'needs (list dependency) 'inputs '("options.txt") 'optimize-level level 'db-dir base))
(define first (project 2))
(check (not (directory-exists? out)) "constructing chez-project created outputs")
(check (not (file-exists? extra)) "constructing chez-project built its dependency")
(build first #f (hash 'dry-run-mode 'dry-run))
(check (not (directory-exists? out)) "Chez dry run created outputs")
(check (not (file-exists? extra)) "Chez dry run built its dependency")
(build first)
(define object (build-path out "demo.so"))
(check (file-exists? (build-path out "demo/z.so")) "nested .ss library was not compiled")
(check (file-exists? (build-path out "support.so")) "external library was not compiled into the output directory")
(check (not (file-exists? (build-path src "demo.so"))) "Chez wrote an object into the source directory")
(define script (build-path base "read.ss"))
(write-forms script '((import (chezscheme) (demo)) (display value)))
(define (value)
  (hash-ref (run 'capture? #t $scheme --libdirs $out --script $script) 'stdout))
(check (equal? (value) "12") "compiled libraries cannot be loaded together")
(define before (stamp object))
(build (project 2))
(check (equal? (stamp object) before) "unchanged Chez project rebuilt")
(put (build-path src "options.txt") "two")
(build (project 2))
(check (not (equal? (stamp object) before)) "extra input relative to base did not trigger recompilation")
(write-forms z (list (library '(demo z) 'z 8)))
(build (project 2))
(check (equal? (value) "13") "source edit did not update dependent library")
(write-forms input (list (library '(support) 'extra 6)))
(build (project 2))
(check (equal? (value) "14") "external source change did not propagate through needs")
(write-forms added (list (library '(demo added) 'added 9)))
(build (project 2))
(check (file-exists? (build-path out "demo/added.so")) "new unreferenced library was not discovered")
(rm added)
(build (project 2))
(check (not (file-exists? (build-path out "demo/added.so"))) "removed source left a stale object")
(rm (build-path out "demo/z.so"))
(build (project 2))
(check (equal? (value) "14") "missing co-output was not repaired")
(define configured (stamp object))
(build (project 1))
(check (not (equal? (stamp object) configured)) "optimization setting did not trigger recompilation")
(check (equal? (value) "14") "configuration rebuild produced incompatible libraries")
(build (chez-project "demo" (build-path base "directory-only") 'base src 'scheme scheme))
(check (file-exists? (build-path base "directory-only/demo/z.so")) "single source directory was not accepted")
(displayln "zuokit Chez: discovery, dependency order, isolated outputs, incremental rebuilds and configuration passed")
