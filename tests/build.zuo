#lang zuo

(require "../zuokit.zuo")

(define self (path->complete-path (quote-module-path)))
(define zuo (hash-ref (runtime-env) 'exe))
(define (emit text code) (cmd $zuo $self emit $text $code))
(define (check x message) (unless x (error message)))
(define (build-checks base)
  (define (put p text) (mkdir-p (path-only p)) (display-to-file text p :truncate))
  (define (count p) (if (file-exists? p) (length (filter (lambda (s) (not (equal? s ""))) (string-split (file->string p) "\n"))) 0))
  (define input (build-path base "input.txt"))
  (define output (build-path base "nested/output.txt"))
  (define second (build-path base "nested/second.txt"))
  (define log (build-path base "steps.log"))
  (put input "one")
  (define (make value)
    (step (list output second) (list input)
      (lambda ()
        (display-to-file "built\n" log :append)
        (put output (~a value ":" (file->string input))) (put second "second"))
      'config value 'db-dir base))
  (define first (make "a"))
  (check (not (file-exists? output)) "constructing step performed work")
  (build first)
  (build (make "a"))
  (check (= (count log) 1) "unchanged step rebuilt")
  (build (make "b"))
  (check (= (count log) 2) "configuration change did not rebuild")
  (put input "two") (build (make "b"))
  (check (= (count log) 3) "source change did not rebuild")
  (rm second) (build (make "b"))
  (check (= (count log) 4) "missing co-output did not rebuild")
  (void (map
    (lambda (wrap name)
      (define dest (build-path base (~a name ".txt")))
      (define (command-step text)
        (step dest '() (wrap (cmd 'stdout dest $zuo $self emit $text 0)) 'db-dir base))
      (build (command-step "one")) (build (command-step "two"))
      (check (equal? (file->string dest) "two") "command argument change did not rebuild"))
    (list (lambda (command) command) list) '(command command-list)))
  (define failed (run/cmd 'capture? #t 'directory base 'check? #f (cmd $zuo $self failed-step $output $base)))
  (check (not (= (hash-ref failed 'exit) 0)) "failed step was reported as successful")
  (check (equal? (file->string output) "b:two") "failed step deleted an existing output")
  (define dryrun (step output (list input) void 'config "outdated" 'db-dir base))
  (build dryrun #f (hash 'dry-run-mode 'dry-run))
  (check (file-exists? output) "dry run deleted an existing step output")
  (define command (emit "captured 中文" 0))
  (check (equal? (run 'capture? #t 'check? #f git)
                 (run/cmd 'capture? #t 'check? #f (cmd git)))
         "run did not treat a bare executable as a literal")
  (check (= (run/cmd command) 0) "run/cmd did not return a successful command's exit code")
  (check (= (run/cmd 'check? #f (emit "" 5)) 5) "run/cmd lost failure status")
  (define captured (run/cmd 'capture? #t 'directory base command))
  (check (equal? (hash-ref captured 'stdout) "captured 中文") "capture lost stdout")
  (check (= (hash-ref captured 'exit) 0) "capture lost success status")
  (check (equal? (hash-ref captured 'stderr) "") "capture invented stderr")
  (check (= (hash-ref (run/cmd 'capture? #t 'directory base 'check? #f (emit "failed" 5)) 'exit) 5) "capture lost failure status")
  (define io-command (cmd 'dir base 'env (hash 'ZUOKIT_RUN_VALUE "original") $zuo
                          $self io))
  (define stdin (fd-open-input input))
  (define io-result
    (run/cmd 'capture? #t 'directory base 'stdin stdin
         'env (hash 'ZUOKIT_RUN_VALUE "覆盖 中文") io-command))
  (fd-close stdin)
  (check (equal? (hash-ref io-result 'stdout) "覆盖 中文:two") "run lost environment overrides or stdin")
  (check (equal? (hash-ref io-result 'stderr) "diagnostic 中文") "capture lost stderr")
  (define stdout (build-path base "redirect.stdout"))
  (define stderr (build-path base "redirect.stderr"))
  (put stdout "old output that must be truncated")
  (define redirected-input (fd-open-input input))
  (check (= (run/cmd 'stdin redirected-input 'stdout stdout 'stderr stderr io-command) 0) "file redirection failed")
  (fd-close redirected-input)
  (check (equal? (file->string stdout) "original:two") "file stdout or truncation failed")
  (check (equal? (file->string stderr) "diagnostic 中文") "file stderr failed")
  (define borrowed (fd-open-output stdout :truncate))
  (void (run/cmd 'stdout borrowed command))
  (fd-write borrowed ":still open") (fd-close borrowed)
  (check (equal? (file->string stdout) "captured 中文:still open") "run closed a caller-owned stream")
  (check (= (run/cmd 'check? #f 'stdout stdout (emit "failed" 5)) 5) "redirected command lost failure status")
  (check (equal? (file->string stdout) "failed") "failed command lost redirected output")
  (build (step 'capture-thread '()
           (lambda ()
             (check (equal? (hash-ref (run/cmd 'capture? #t 'thread? #t command) 'stdout) "captured 中文")
                    "capture failed in a build thread")) 'db-dir base))
  (check (equal? (hash-ref (run 'capture? #t $zuo $self emit "inline 中文" 0) 'stdout) "inline 中文")
         "inline command capture failed")
  (check (not (= (hash-ref (run 'capture? #t 'check? #f $zuo $self run-failure) 'exit) 0))
         "capture disabled default exit checking")
  (check (not (= (hash-ref (run 'capture? #t 'check? #f $zuo $self capture-conflict) 'exit) 0))
         "capture silently replaced explicit redirection")
  (displayln "zuokit build: incremental steps, configuration, co-outputs, dry run and capture passed"))
(module+ main
  (define args (hash-ref (runtime-env) 'args))
  (cond
    [(and (pair? args) (equal? (car args) "emit"))
     (display (cadr args)) (exit (string->integer (list-ref args 2)))]
    [(and (pair? args) (equal? (car args) "io"))
     (display (~a (cdr (assoc "ZUOKIT_RUN_VALUE" (hash-ref (runtime-env) 'env))) ":" (fd-read (fd-open-input 'stdin) 3)))
     (fd-write (fd-open-output 'stderr) "diagnostic 中文")]
    [(and (pair? args) (equal? (car args) "run-failure"))
     (void (run/cmd 'capture? #t (emit "expected failure" 7)))]
    [(and (pair? args) (equal? (car args) "capture-conflict"))
     (void (run/cmd 'capture? #t 'stdout (fd-open-output 'stdout) (emit "conflict" 0)))]
    [(and (pair? args) (equal? (car args) "failed-step"))
     (build (step (cadr args) '() (emit "failed action" 7) 'db-dir (list-ref args 2)))]
    [else
     (define time (current-time))
     (build-checks (build-path (hash-ref (runtime-env) 'dir) "build"
                              (~a "build test-" (car time) "-" (cdr time))))]))
