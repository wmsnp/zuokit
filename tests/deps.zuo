#lang zuo

(require "../zuokit.zuo")

(define time (current-time))
(define base (simple-form-path (build-path (hash-ref (runtime-env) 'dir) "build" (~a "zuokit test-" (car time) "-" (cdr time)))))
(mkdir-p base)
(define store (build-path base "deps"))
(define lock (build-path base "deps.lock"))
(define (check value message) (unless value (error message)))
(define (put path text) (mkdir-p (path-only path)) (display-to-file text path :truncate))
(define (url path) (~a "file://" (if (eq? (system-type) 'windows) "/" "")
                      (string-join (string-split (string-join (string-split path "\\") "/") " ") "%20")))
(define (text dir) (file->string (build-path dir "value.txt")))
(define (sync declarations) (deps-sync declarations store 'base base 'lock lock))
(define (fails expression)
  (define script (build-path base "failure.zuo"))
  (put script (~a "#lang zuo\n(require " (~s (simple-form-path (build-path (hash-ref (runtime-env) 'dir) "zuokit.zuo"))) ")\n" expression "\n"))
  (define stderr (fd-open-output (build-path base "expected-error.log") :truncate))
  (define status (run 'check? #f 'stderr stderr ($ (hash-ref (runtime-env) 'exe)) $script))
  (fd-close stderr)
  (not (= status 0)))

(define source (build-path base "upstream"))
(mkdir source)
(put (build-path source "value.txt") "one\n")
(run git -C $source init -b main)
(run git -C $source add --all)
(run git -C $source -c user.name=zuokit -c user.email=test@example.invalid commit -m initial)
(run git -C $source -c user.name=zuokit -c user.email=test@example.invalid tag -a initial -m initial)

(define patch (build-path base "change.patch"))
(put patch "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-one\n+patched\n")
(define fixture (build-path base "fixture"))
(put (build-path fixture "project/lib/core/value.txt") "one\n")
(define files
  (map (lambda (format flags)
         (define file (build-path base (~a "download-" format)))
         (run bsdtar @flags $file -C $fixture project)
         (cons format file))
       '(tar tar.gz tar.xz zip)
       '(("-cf") ("-czf") ("-cJf") ("--format=zip" "-cf"))))
(define tar-file (cdr (assoc 'tar files)))
(define tar-hash (file-sha256 tar-file #f))
(define declarations
  (deps
    [floating (git source 'ref "refs/heads/main")]
    [patched (local source 'patches (list patch))]
    [live (local source)]
    [keep (archive (url tar-file) 'sha256 tar-hash)]
    [single (archive (url tar-file) 'sha256 tar-hash 'root 'single)]
    [nested (archive (url tar-file) 'sha256 tar-hash 'root "project/lib/core" 'patches (list patch))]))
(define resolved (sync declarations))
(check (equal? (text (hash-ref resolved 'floating)) "one\n") "git checkout failed")
(check (equal? (text (hash-ref resolved 'patched)) "patched\n") "local patch failed")
(check (equal? (text (hash-ref resolved 'nested)) "patched\n") "archive patch/root failed")
(check (equal? (text source) "one\n") "patch modified the original local source")
(check (file-exists? (build-path (hash-ref resolved 'keep) "project/lib/core/value.txt")) "keep root failed")
(check (file-exists? (build-path (hash-ref resolved 'single) "lib/core/value.txt")) "single root failed")
(check (equal? (hash-ref resolved 'live) source) "local dependency is not live")
(define first-lock (file->string lock))
(define first-commit (list-ref (assoc 'floating (cddr (car (string-read first-lock)))) 3))
(define tagged (deps-sync (deps [tagged (git source 'ref "refs/tags/initial")]) (build-path base "tagged")
                          'lock (build-path base "tagged.lock") 'cache (build-path store ".cache")))
(check (equal? (text (hash-ref tagged 'tagged)) "one\n") "annotated tag did not resolve to a commit")

(for-each (lambda (entry)
            (define file (cdr entry))
            (define spec (archive (url file) 'sha256 (file-sha256 file #f) 'root "project/lib/core"))
            (define result (deps-sync (hash 'format spec) (build-path base (~a (car entry)))
                                      'lock (build-path base (~a (car entry) ".lock"))))
            (check (equal? (text (hash-ref result 'format)) "one\n") "format detection failed")) files)

(put (build-path source "value.txt") "two\n")
(run git -C $source add --all)
(run git -C $source -c user.name=zuokit -c user.email=test@example.invalid commit -m update)
(define only-git (deps [floating (git source 'ref "refs/heads/main")]))
(check (equal? (text (hash-ref (sync only-git) 'floating)) "one\n") "sync upgraded a locked ref")
(check (equal? (file->string lock) first-lock) "sync changed an unchanged lock")
(void (deps-upgrade only-git store 'base base 'lock lock 'names '(floating)))
(check (equal? (text (hash-ref (sync only-git) 'floating)) "two\n") "upgrade did not advance the ref")
(check (not (equal? (file->string lock) first-lock)) "upgrade did not change the lock")

(define offline (build-path base "upstream-offline"))
(mv source offline)
(define restored (deps-sync only-git (build-path base "restored") 'base base 'lock lock 'cache (build-path store ".cache")))
(check (equal? (text (hash-ref restored 'floating)) "two\n") "cached git cannot materialize offline")
(mv offline source)

(define manifest (build-path base "manifest.zuo"))
(put manifest (~a "#lang zuo\n(require " (~s (simple-form-path (build-path (hash-ref (runtime-env) 'dir) "zuokit.zuo")))
                 ")\n(provide dependencies)\n(define dependencies (deps [floating (git " (~s source) " 'ref \"refs/heads/main\")]))\n"))
(run ($ (hash-ref (runtime-env) 'exe)) ($ (build-path (hash-ref (runtime-env) 'dir) "zuokit.zuo")) upgrade $manifest floating)
(check (fails (~s `(deps-sync (deps [floating (git ,source 'ref "refs/heads/changed")]) ,store 'lock ,lock)))
       "changed ref silently replaced its lock")

;; A full commit needs no moving-ref resolution; patches still use a copy.
(define pinned (deps [pin (git source 'commit first-commit 'patches (list patch))]))
(check (equal? (text (hash-ref (sync pinned) 'pin)) "patched\n") "pinned git patch failed")
(check (equal? (text source) "two\n") "git patch modified upstream")
(put patch "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-one\n+revised\n")
(check (equal? (text (hash-ref (sync pinned) 'pin)) "revised\n") "patch content change did not rematerialize")
(put patch "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-wrong\n+broken\n")
(check (fails (~s `(deps-sync (deps [pin (git ,source 'commit ,first-commit 'patches (list ,patch))]) ,store 'lock ,lock)))
       "invalid patch succeeded")
(check (equal? (text (build-path store "pin")) "revised\n") "failed patch replaced an existing materialization")
(check (equal? (text (hash-ref (sync (deps [pin (git source 'commit first-commit)])) 'pin)) "one\n")
       "unpatched git source contains cached patches")
(check (equal? (file-sha256 tar-file #f) tar-hash) "archive input changed")

;; Errors run in a child Zuo: error terminates rather than raising an exception.
(define (bad-archive . options)
  (~s `(deps-sync (deps [bad (archive ,(url tar-file) 'sha256 ,tar-hash ,@options)]) ,(build-path base "bad") 'lock ,lock)))
(check (fails (bad-archive ''root "../outside")) "escaping root accepted")
(check (fails (bad-archive ''root "missing")) "missing root accepted")
(check (fails (bad-archive ''fmt ''zip)) "removed fmt option accepted")
(check (fails (~s `(archive ,(url tar-file) 'sha256 ,tar-hash 'strip 1))) "strip option accepted")
(check (fails (~s `(deps [duplicate (local ".")] [duplicate (local ".")]))) "duplicate dependency accepted")
(check (fails (~s `(deps-sync (deps [bad (git ,source 'commit "short")])
                             ,(build-path base "bad-git") 'lock ,lock))) "invalid git revision accepted")
(check (fails (~s `(deps-sync (deps [bad (git ,source 'commit "refs/heads/main")])
                             ,(build-path base "bad-pin") 'lock ,lock))) "moving ref accepted as a commit pin")
(check (fails (~s `(deps-sync (deps [bad (archive ,(url tar-file) 'sha256 ,(string-sha256 "wrong"))])
                             ,(build-path base "bad-hash") 'lock ,lock))) "incorrect hash accepted")

(put (build-path fixture "top-level.txt") "not a directory\n")
(define multiple (build-path base "multiple"))
(run bsdtar -cf $multiple -C $fixture project top-level.txt)
(check (fails (~s `(deps-sync (deps [bad (archive ,(url multiple) 'sha256 ,(file-sha256 multiple #f) 'root 'single)])
                             ,(build-path base "bad-single") 'lock ,lock))) "single accepted multiple top-level entries")
(displayln "zuokit: archive formats/roots, patch isolation/invalidation, local sources and git lock/upgrade passed")

;; Constructing dependency targets is inert; deleting a required output repairs
;; it from the raw cache, while edits to a patched local source update its copy.
(define graph-store (build-path base "graph deps"))
(define graph-patch (build-path base "graph.patch"))
(put graph-patch "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-one\n+graph\n")
(define graph-local (build-path base "local graph"))
(put (build-path graph-local "value.txt") "one\n")
(put (build-path graph-local "other.txt") "old\n")
(define graph-spec
  (deps [remote (archive (url tar-file) 'sha256 tar-hash 'root "project/lib/core")]
        [copy (local graph-local 'patches (list graph-patch))]
        [live (local graph-local)]
        [unused (git (build-path base "does-not-exist") 'ref "HEAD")]))
(define (graph-targets)
  (deps-targets graph-spec graph-store 'base base 'lock (build-path base "graph.lock")
                'outputs (hash 'remote '("value.txt") 'copy '("value.txt" "other.txt") 'live '("value.txt" "other.txt"))))
(define graph (graph-targets))
(check (not (directory-exists? graph-store)) "dependency target construction performed work")
(build (hash-ref graph 'remote))
(define remote (target-path (hash-ref graph 'remote)))
(check (equal? (text remote) "one\n") "dependency target did not materialize")
(rm (build-path remote "value.txt"))
(build (hash-ref (graph-targets) 'remote))
(check (equal? (text remote) "one\n") "missing required output was not repaired")
(build (hash-ref graph 'live))
(check (equal? (target-path (hash-ref graph 'live)) graph-local) "local target is not a live source")
(check (not (file-exists? (build-path graph-store ".state/live"))) "live local source acquired managed state")
(build (hash-ref (graph-targets) 'copy))
(define copied (target-path (hash-ref graph 'copy)))
(check (equal? (text copied) "graph\n") "local graph patch failed")
(put (build-path graph-local "other.txt") "new\n")
(build (hash-ref (graph-targets) 'copy))
(check (equal? (file->string (build-path copied "other.txt")) "new\n") "local graph source edit was not copied")
(check (equal? (text graph-local) "one\n") "graph patch touched original source")
(build (hash-ref (graph-targets) 'copy))
(displayln "zuokit dependency targets: lazy materialization, output repair and local edit tracking passed")

(define moving-store (build-path base "moving graph"))
(define moving-lock (build-path base "moving.lock"))
(define moving-spec (deps [moving (git source 'ref "refs/heads/main")]))
(define (moving-target)
  (hash-ref (deps-targets moving-spec moving-store 'base base 'lock moving-lock
                         'outputs (hash 'moving '("value.txt"))) 'moving))
(define moving (moving-target))
(build moving)
(check (equal? (text (target-path moving)) "two\n") "moving graph ref did not resolve")
(put (build-path source "value.txt") "three\n")
(run git -C $source add --all)
(run git -C $source -c user.name=zuokit -c user.email=test@example.invalid commit -m graph-update)
(build (moving-target))
(check (equal? (text (target-path moving)) "two\n") "dependency graph silently upgraded lock")
(void (deps-upgrade moving-spec moving-store 'base base 'lock moving-lock))
(build (moving-target))
(check (equal? (text (target-path moving)) "three\n") "lock upgrade did not invalidate dependency target")
(displayln "zuokit dependency targets: moving Git ref stays locked until explicit upgrade")
