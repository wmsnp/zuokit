#lang zuo

(provide run run/cmd cmd fetch write-forms deps git archive local deps-sync deps-upgrade deps-targets cmake-project chez-project
         step suite test-suite bench-suite suite-targets diff batch measured defer test-run bench-run report)

(define (env-pairs x)
  (map (lambda (p) (cons (~a (car p)) (and (cdr p) (~a (cdr p)))))
       (if (hash? x) (map (lambda (k) (cons k (hash-ref x k))) (hash-keys x)) x)))
(define (same-env-name? a b) (if (eq? (system-type) 'windows) (string-ci=? a b) (string=? a b)))
(define (patch-env base changes)
  (foldl
    (lambda (p env) (let ([r (filter (lambda (old) (not (same-env-name? (car old) (car p)))) env)]) (if (cdr p) (cons p r) r)))
    base changes))
(define (merge-opts base extra)
  (foldl (lambda (k h) (hash-set h k (hash-ref extra k))) base (hash-keys extra)))
(define (hash-with h . kvs) (merge-opts h (apply hash kvs)))
(define (apply-run-option e opts)
  (let ([k (car e)] [v (cdr e)])
    (cond
      [(eq? k 'with) (merge-opts opts v)]
      [(eq? k 'env) (hash-set opts 'env (patch-env (hash-ref opts 'env (hash-ref (runtime-env) 'env)) (env-pairs v)))]
      [(eq? k 'env!) (hash-set opts 'env (patch-env '() (env-pairs v)))]
      [else (hash-set opts k v)])))
(define (run-argv directives argv)
  (let* ([cfg (foldl apply-run-option (hash) directives)] [ck? (hash-ref cfg 'check? #t)] [thread? (hash-ref cfg 'thread? #f)]
         [cap? (hash-ref cfg 'capture? #f)]
         [opts (foldl (lambda (k h) (hash-remove h k)) cfg '(check? thread? capture? directory))] [name (car argv)]
         [exe (if (equal? (file-name-from-path name) name) (or (find-executable-path name) (error "executable not found" name)) name)])
    (for-each (lambda (k) (when (eq? (hash-ref opts k #f) 'pipe) (error "run: unhandled pipe" k))) '(stdin stdout stderr))
    (when (hash-ref opts 'exec? #f) (error "run: exec? is incompatible with waiting"))
    (when (and cap? (or (hash-ref opts 'stdout #f) (hash-ref opts 'stderr #f)))
      (error "run: capture? conflicts with stdout/stderr redirection"))
    (let* ([dir (and cap? (scratch (absolute (hash-ref (runtime-env) 'dir) (hash-ref cfg 'directory "build/zuokit"))))]
           [redirected (if cap? (hash-with opts 'stdout (build-path dir "stdout") 'stderr (build-path dir "stderr")) opts)]
           [files (map (lambda (k) (cons k (fd-open-output (hash-ref redirected k) :truncate)))
                       (filter (lambda (k) (string? (hash-ref redirected k #f))) '(stdout stderr)))]
           [r (apply process (append (list exe) (cdr argv) (list (foldl (lambda (p h) (hash-set h (car p) (cdr p))) redirected files))))]
           [p (hash-ref r 'process)])
      (if thread? (thread-process-wait p) (process-wait p))
      (for-each (lambda (p) (fd-close (cdr p))) files)
      (let* ([st (process-status p)]
             [v (if cap? (hash 'exit st 'stdout (file->string (build-path dir "stdout")) 'stderr (file->string (build-path dir "stderr"))) st)])
        (when cap? (rm* dir))
        (when (and ck? (not (= st 0))) (error "command failed" argv st (if cap? (hash-ref v 'stderr) "")))
        v))))
(define-syntax (command-form stx)
  (define (cp-part x)
    (cond
      [(identifier? x)
       (let ([s (symbol->string (syntax-e x))])
         (if (and (> (string-length s) 1) (member (substring s 0 1) '("$" "@")))
             (cp-part (list (datum->syntax x (string->symbol (substring s 0 1)))
                            (datum->syntax x (string->symbol (substring s 1 (string-length s))))))
             `(,(quote-syntax list) ,s)))]
      [(or (string? x) (integer? x)) `(,(quote-syntax list) ,(~a x))]
      [(and (pair? x) (identifier? (car x)) (pair? (cdr x)) (null? (cddr x)))
       (cond
         [(eq? (syntax-e (car x)) '$) `(,(quote-syntax list) (,(quote-syntax ~a) ,(cadr x)))]
         [(eq? (syntax-e (car x)) '@) `(,(quote-syntax map) ,(quote-syntax ~a) ,(cadr x))]
         [else (syntax-error "invalid run argument" x)])]
      [else (syntax-error "invalid run argument" x)]))
  (define (option-name x)
    (let ([d (syntax->datum x)]) (and (pair? d) (eq? (car d) 'quote) (pair? (cdr d)) (symbol? (cadr d)) (null? (cddr d)) (cadr d))))
  (define (option-expr k v) `(,(quote-syntax cons) (,(quote-syntax quote) ,k) ,v))
  (define (parse-run parts rev-opts stx)
    (when (null? parts) (syntax-error "run: missing executable" stx))
    (let ([k (option-name (car parts))])
      (if k
        (begin
          (unless (member k '(dir env env! stdin stdout stderr check? thread? capture? directory with)) (syntax-error "run: unknown option" (car parts)))
          (when (null? (cdr parts)) (syntax-error "run: missing option value" (car parts)))
          (parse-run (cddr parts) (cons (option-expr k (cadr parts)) rev-opts) stx))
        (let ([command? (eq? (syntax-e (cadr stx)) 'run-command)])
          (when (and command? (pair? (cdr parts))) (syntax-error "run/cmd: expected one cmd expression" stx))
          `(,(cadr stx) (,(quote-syntax list) ,@(reverse rev-opts))
                       ,(if command? (car parts) `(,(quote-syntax append) ,@(map cp-part parts))))))))
  (parse-run (cddr stx) '() stx))
(define-syntax (run stx) `(,(quote-syntax command-form) ,(quote-syntax run-argv) ,@(cdr stx)))
(define-syntax (run/cmd stx) `(,(quote-syntax command-form) ,(quote-syntax run-command) ,@(cdr stx)))
(define-syntax (cmd stx) `(,(quote-syntax command-form) ,(quote-syntax make-command) ,@(cdr stx)))
(define (make-command directives argv) (hash 'kind 'cmd 'directives directives 'argv argv))
(define (run-command directives c)
  (run-argv (append (hash-ref c 'directives) directives) (hash-ref c 'argv)))
(define (write-forms path forms)
  (mkdir-p (path-only path))
  (display-to-file (apply ~a (map (lambda (form) (~a (~s form) "\n")) forms)) path :truncate))
(define (fetch url output . options) (run 'with (apply hash options) curl --fail --location --output $output -- $url))
(define (check-opts opts allowed)
  (define h (if (hash? opts) opts (apply hash opts)))
  (for-each (lambda (k) (unless (member k allowed) (error "unknown option" k))) (hash-keys h))
  h)
(define (dependency kind location opts allowed)
  (define h (check-opts opts (cons 'patches allowed)))
  (hash-with h 'kind kind 'location location))
(define (git url . opts)
  (define h (dependency 'git url opts '(commit ref)))
  (when (and (hash-ref h 'commit #f) (hash-ref h 'ref #f)) (error "git: choose commit or ref"))
  (if (hash-ref h 'commit #f) h (hash-set h 'ref (hash-ref h 'ref "HEAD"))))
(define (archive url . opts) (dependency 'archive url opts '(sha256 root)))
(define (local path . opts) (dependency 'local path opts '()))
(define-syntax (deps stx)
  (define (entry e)
    (unless (and (list? e) (= (length e) 2) (identifier? (car e))) (syntax-error "expected [name source]" e))
    (list `(,(quote-syntax quote) ,(syntax-e (car e))) (cadr e)))
  (define entries (map entry (cdr stx)))
  (unless (= (hash-count (foldl (lambda (e h) (hash-set h (syntax-e (car e)) #t)) (hash) (cdr stx))) (length entries))
    (syntax-error "duplicate dependency name" stx))
  `(,(quote-syntax hash) ,@(apply append entries)))

(define (absolute base path)
  (define p (simple-form-path (if (relative-path? path) (build-path base path) path)))
  (if (eq? (system-type) 'windows) (string-join (string-split p "/") "\\") p))
(define (dep-names specs)
  (define names (hash-keys specs))
  (for-each
    (lambda (name)
      (define s (symbol->string name))
      (when (or (equal? s "") (glob-match? "*[^a-z0-9_-]*" s)) (error "dependency names use lowercase letters, digits, - and _" name))) names)
  names)
(define (dep-context directory options)
  (define h (check-opts options '(base cache lock thread? names)))
  (define base (absolute (hash-ref (runtime-env) 'dir) (hash-ref h 'base ".")))
  (define dir (absolute base directory))
  (hash 'base base 'dir dir 'cache (absolute base (hash-ref h 'cache (build-path dir ".cache"))) 'lock (absolute base (hash-ref h 'lock "deps.lock"))
        'thread? (hash-ref h 'thread? #f) 'names (hash-ref h 'names #t)))
(define (scratch parent)
  (mkdir-p parent)
  (define time (current-time))
  (define dir (build-path parent (~a ".tmp-" (car time) "-" (cdr time))))
  (mkdir dir)
  dir)
(define (write-sexp path v)
  (mkdir-p (path-only path))
  (define stage (scratch (path-only path))) (define file (build-path stage "value"))
  (display-to-file (~a (~s v) "\n") file)
  (mv file path)
  (rmdir stage))
(define (read-sexp path)
  (define values (string-read (file->string path)))
  (unless (= (length values) 1) (error "expected one S-expression" path))
  (car values))
(define (retry-command thunk)
  (let loop ([left 3])
    (define st (thunk))
    (unless (= st 0) (if (= left 1) (error "dependency command failed after 3 attempts" st) (loop (- left 1))))))
(define (git-repo src ctx)
  (define repo (build-path (hash-ref ctx 'cache) "git" (string-sha256 (hash-ref src 'location))))
  (unless (directory-exists? repo) (mkdir-p (path-only repo)) (run 'thread? (hash-ref ctx 'thread?) git init --bare $repo))
  repo)
(define (git-text repo ctx . args)
  (define r (run 'thread? (hash-ref ctx 'thread?) 'capture? #t 'directory (hash-ref ctx 'cache) git --git-dir $repo @args))
  (string-trim (string-trim (hash-ref r 'stdout) "\n") "\r"))
(define (git-fetch src revision ctx)
  (define repo (git-repo src ctx))
  (define url (hash-ref src 'location))
  (retry-command (lambda () (run 'thread? (hash-ref ctx 'thread?) 'check? #f git --git-dir $repo fetch --no-tags --depth=1 -- $url $revision)))
  (define commit (git-text repo ctx "rev-list" "-1" "FETCH_HEAD"))
  (when (and (hash-ref src 'commit #f) (not (equal? commit revision))) (error "git commit mismatch" revision commit))
  (run 'thread? (hash-ref ctx 'thread?) git --git-dir $repo update-ref ($ (~a "refs/zuokit/" commit)) $commit)
  commit)
(define (locked-deps specs ctx upgrade)
  (define names (dep-names specs))
  (unless (or (eq? upgrade #f) (eq? upgrade #t) (and (list? upgrade) (andmap (lambda (n) (member n names)) upgrade)))
    (error "unknown dependency in upgrade" upgrade))
  (define lock (hash-ref ctx 'lock))
  (define prev (if (file-exists? lock) (read-sexp lock) '(zuokit-lock 1)))
  (unless (and (list? prev) (>= (length prev) 2) (equal? (car prev) 'zuokit-lock) (= (cadr prev) 1))
    (error "unsupported dependency lock" lock))
  (define entries (cddr prev))
  (define resolved
    (foldl
      (lambda (name r)
        (define src (hash-ref specs name))
        (define ref (hash-ref src 'ref #f))
        (define e (assoc name entries))
        (define update? (or (eq? upgrade #t) (and (list? upgrade) (member name upgrade))))
        (hash-set r name
          (if (and (eq? (hash-ref src 'kind) 'git) ref)
              (hash-set src 'commit
                (cond
                  [(or update? (not e)) (git-fetch src ref ctx)]
                  [(and (= (length e) 4) (equal? (cadr e) (hash-ref src 'location)) (equal? (list-ref e 2) ref)) (list-ref e 3)]
                  [else (error "dependency source changed; run upgrade" name)]))
              src))) (hash) names))
  (define current
    `(zuokit-lock 1 ,@(map (lambda (name)
                            (define src (hash-ref resolved name))
                            (list name (hash-ref src 'location) (hash-ref src 'ref) (hash-ref src 'commit)))
                          (filter (lambda (name) (hash-ref (hash-ref resolved name) 'ref #f)) names))))
  (unless (equal? prev current) (write-sexp lock current))
  resolved)
(define (archive-file src ctx)
  (define sha (hash-ref src 'sha256))
  (define dest (build-path (hash-ref ctx 'cache) "archives" (string-sha256 sha)))
  (unless (file-exists? dest)
    (define stage (scratch (path-only dest)))
    (define file (build-path stage "download"))
    (retry-command (lambda () (fetch (hash-ref src 'location) file 'thread? (hash-ref ctx 'thread?) 'check? #f)))
    (unless (equal? (file-sha256 file #f) sha) (error "archive SHA-256 mismatch" (hash-ref src 'location)))
    (mv file dest)
    (rmdir stage))
  dest)
(define (extract file dest ctx)
  (mkdir dest)
  (run 'thread? (hash-ref ctx 'thread?) bsdtar -xf $file -C $dest --no-same-owner))
(define (select-root dir root)
  (cond
    [(eq? root 'keep) dir]
    [(eq? root 'single)
     (define entries (ls* dir))
     (unless (and (= (length entries) 1) (directory-exists? (car entries)) (not (link-exists? (car entries))))
       (error "archive root single requires exactly one top-level directory" dir))
     (car entries)]
    [else
     (unless (and (relative-path? root) (not (equal? root "")) (not (member ".." (explode-path root))))
       (error "archive root must stay inside the extracted directory" root))
     (define selected
       (foldl (lambda (part dir)
                (define next (build-path dir part))
                (when (link-exists? next) (error "archive root crosses a symbolic link" root)) next)
              dir (explode-path root)))
     (unless (directory-exists? selected) (error "archive root is not a directory" root))
     selected]))
(define (materialized? dest state outputs)
  (and (directory-exists? dest) (or (not state) (file-exists? state)) (andmap (lambda (p) (file-exists? (build-path dest p))) outputs)))
(define (materialize src dest ctx)
  (define kind (hash-ref src 'kind))
  (define base (hash-ref ctx 'base))
  (define patches (map (lambda (p) (absolute base p)) (hash-ref src 'patches '())))
  (define location (hash-ref src 'location))
  (cond
    [(and (eq? kind 'local) (null? patches))
     (define path (absolute base location))
     (unless (directory-exists? path) (error "local dependency is not a directory" path)) path]
    [else
     (define state (build-path (hash-ref ctx 'dir) ".state" (file-name-from-path dest)))
     (define identity (list kind location (hash-ref src 'commit #f) (hash-ref src 'sha256 #f) (hash-ref src 'root 'keep)
                            (map (lambda (p) (list p (file-sha256 p (hash-ref ctx 'token #f)))) patches)))
     (unless (and (not (eq? kind 'local)) (materialized? dest state (hash-ref ctx 'outputs '())) (equal? (read-sexp state) identity))
       (define stage (scratch (build-path (hash-ref ctx 'dir) ".stage")))
       (define raw (build-path stage "raw"))
       (cond
         [(eq? kind 'archive) (extract (archive-file src ctx) raw ctx)]
         [(eq? kind 'local) (cp* (absolute base location) raw)]
         [else
          (define repo (git-repo src ctx))
          (define commit (hash-ref src 'commit))
          (unless (= (run 'thread? (hash-ref ctx 'thread?) 'check? #f git --git-dir $repo show-ref --verify --quiet ($ (~a "refs/zuokit/" commit))) 0)
            (git-fetch (hash-remove src 'ref) commit ctx))
          (define tree (git-text repo ctx "ls-tree" "-r" commit))
          (when (ormap (lambda (line) (equal? (car (string-split line " ")) "160000")) (string-split tree "\n"))
            (error "git submodules require explicit dependency declarations" location))
          (define file (build-path stage "tree.tar"))
          (run 'thread? (hash-ref ctx 'thread?) git --git-dir $repo archive --format=tar -o $file $commit)
          (extract file raw ctx)])
       (define selected (select-root raw (hash-ref src 'root 'keep)))
       (for-each (lambda (patch)
                   (run 'thread? (hash-ref ctx 'thread?) 'dir selected
                        'env (hash 'GIT_CEILING_DIRECTORIES (path-only selected))
                        git apply --no-index --whitespace=nowarn -- $patch)) patches)
       (for-each (lambda (p) (unless (file-exists? (build-path selected p)) (error "missing dependency output" p)))
                 (hash-ref ctx 'outputs '()))
       (when (or (directory-exists? dest) (file-exists? dest) (link-exists? dest))
         (unless (file-exists? state) (error "refusing to replace an unmanaged dependency directory" dest))
         (rm* dest))
       (mv selected dest)
       (write-sexp state identity)
       (rm* stage))
     dest]))
(define (deps-sync specs directory . opts)
  (define ctx (dep-context directory opts))
  (define resolved (locked-deps specs ctx #f))
  (mkdir-p (hash-ref ctx 'dir))
  (foldl (lambda (name r) (hash-set r name (materialize (hash-ref resolved name) (build-path (hash-ref ctx 'dir) (symbol->string name)) ctx)))
         (hash) (dep-names resolved)))
(define (deps-upgrade specs directory . opts)
  (define ctx (dep-context directory opts))
  (locked-deps specs ctx (hash-ref ctx 'names)))

(define (perform a)
  (cond [(procedure? a) (perform (a))]
        [(eq? (kind a) 'cmd) (void (run/cmd 'thread? #t 'check? #t a))]
        [(list? a) (for-each perform a)]
        [(void? a) (void)]
        [else (error "expected cmd, action thunk or list of actions" a)]))
(define (data-input label identity v)
  (input-data-target (string->symbol (~a label "-" (string-sha256 (~a identity)))) v))
(define (step output inputs a . options)
  (define cfg (check-opts options '(config db-dir precious? needs)))
  (define outputs (map (lambda (p) (if (symbol? p) p (absolute (hash-ref (runtime-env) 'dir) p))) (if (list? output) output (list output))))
  (define name (car outputs))
  (when (and (symbol? name) (pair? (cdr outputs))) (error "phony step cannot have file co-outputs" output))
  (define sig (list (hash-ref cfg 'config (hash)) (if (procedure? a) 'thunk a)))
  (define (as-target t) (if (target? t) t (input-file-target (absolute (hash-ref (runtime-env) 'dir) t))))
  (define needs (map as-target (hash-ref cfg 'needs '())))
  (define (dependencies token)
    (for-each (lambda (t) (unless (symbol? (target-name t)) (build/dep t token))) needs)
    (map as-target (append needs (if (procedure? inputs) (inputs) inputs) (list (quote-module-path) (data-input "step" name sig)))))
  (define opts (hash 'precious? (hash-ref cfg 'precious? #t)))
  (define target-opts
    (merge-opts (if (hash-ref cfg 'db-dir #f) (hash-set opts 'db-dir (hash-ref cfg 'db-dir)) opts)
                (if (symbol? name) (hash) (hash 'co-outputs (cdr outputs)))))
  (define (rebuild)
    (when (hash-ref cfg 'db-dir #f) (mkdir-p (hash-ref cfg 'db-dir)))
    (unless (symbol? name) (for-each (lambda (p) (mkdir-p (path-only p))) outputs))
    (perform a))
  (target name (if (symbol? name) (lambda (token) (phony-rule (dependencies token) rebuild))
                   (lambda (path token) (rule (dependencies token) rebuild))) target-opts))

(define (tree-state dir token)
  (map (lambda (p) (if (directory-exists? p) (list p (tree-state p token)) (list p (file-sha256 p token)))) (sort (ls* dir) string<?)))
(define (deps-targets specs directory . options)
  (define opts (check-opts options '(base cache lock db-dir outputs)))
  (define ctx (dep-context directory (hash-remove (hash-remove opts 'db-dir) 'outputs)))
  (define db (absolute (hash-ref ctx 'base) (hash-ref opts 'db-dir (hash-ref ctx 'dir))))
  (define target-opts (hash 'db-dir db 'precious? #t))
  (define (lock-sha)
    (string-sha256 (~s (if (file-exists? (hash-ref ctx 'lock)) (read-sexp (hash-ref ctx 'lock)) '(zuokit-lock 1)))))
  (define lock-target
    (target (hash-ref ctx 'lock)
      (lambda (path token) (rule (list (data-input "deps" path specs)) (lambda () (mkdir-p db) (locked-deps specs ctx #f) (lock-sha)) (lock-sha)))
      target-opts))
  (foldl
    (lambda (name r)
      (define src (hash-ref specs name))
      (define moving? (and (eq? (hash-ref src 'kind) 'git) (hash-ref src 'ref #f)))
      (define local? (eq? (hash-ref src 'kind) 'local))
      (define original (and local? (absolute (hash-ref ctx 'base) (hash-ref src 'location))))
      (define live? (and local? (null? (hash-ref src 'patches '()))))
      (define dest (if live? original (build-path (hash-ref ctx 'dir) (~a name))))
      (define state (build-path (hash-ref ctx 'dir) ".state" (~a name)))
      (define outputs (hash-ref (hash-ref opts 'outputs (hash)) name '()))
      (define (ready?) (materialized? dest (and (not live?) state) outputs))
      (define (source-sha token)
        (if (ready?) (string-sha256 (~s (list (if live? src (read-sexp state)) (and local? (tree-state original token))))) no-sha256))
      (define patches (map (lambda (p) (absolute (hash-ref ctx 'base) p)) (hash-ref src 'patches '())))
      (hash-set r name
        (target dest
          (lambda (path token)
            (rule (append (if moving? (list lock-target) '()) (list (data-input "source" dest (list src outputs))) patches)
                  (lambda ()
                    (define resolved (if moving? (locked-deps specs ctx #f) specs))
                    (materialize (hash-ref resolved name) dest (hash-with ctx 'outputs outputs 'token token))
                    (unless (ready?) (error "dependency did not provide declared outputs" name outputs))
                    (source-sha token))
                  (source-sha token))) target-opts)))
    (hash) (dep-names specs)))

(define (find-files paths patterns)
  (apply append
    (map (lambda (p)
           (cond [(directory-exists? p) (find-files (sort (ls* p) string<?) patterns)]
                 [(ormap (lambda (pattern) (glob-match? pattern p)) patterns) (list p)]
                 [else '()])) paths)))
(define (chez-project sources dir . opts)
  (define cfg (check-opts opts '(base scheme args library-dirs optimize-level inputs needs db-dir)))
  (define base (absolute (hash-ref (runtime-env) 'dir) (hash-ref cfg 'base ".")))
  (define out (absolute base dir))
  (define (at-base p) (if (target? p) p (absolute base p)))
  (define patterns '("*.sls" "*.ss" "*.scm" "*.sch"))
  (define files (find-files (map (lambda (p) (absolute base p)) (if (list? sources) sources (list sources))) patterns))
  (when (null? files) (error "chez-project: no library sources" sources))
  (define objects
    (map (lambda (p)
           (define rel (find-relative-path base p))
           (unless (and (relative-path? rel) (not (member ".." (explode-path rel)))) (error "chez-project: source is outside base" p))
           (build-path out (path-replace-extension rel ".so"))) files))
  (define dirs (map (lambda (p) (absolute base p)) (hash-ref cfg 'library-dirs '())))
  (define roots (cons base dirs))
  (define scheme (hash-ref cfg 'scheme "scheme"))
  (define args (hash-ref cfg 'args '()))
  (define script (build-path out "compile.ss"))
  (define forms
    `((import (chezscheme))
      (define args (cdr (command-line))) (define out (car args))
      (library-directories (map (lambda (p) (cons p out)) (list-head (cdr args) ,(length roots))))
      (library-extensions '(".chezscheme.sls" ".sls" ".ss" ".scm" ".sch"))
      (compile-imported-libraries #t) (optimize-level ,(hash-ref cfg 'optimize-level 2))
      (for-each (lambda (p) (eval (list 'import (list 'only (cadr (call-with-input-file p read)))) (interaction-environment)))
                (list-tail (cdr args) ,(length roots)))))
  (define c (cmd 'dir base $scheme @args --script $script $out @roots @files))
  (step objects (lambda () (append files (find-files dirs patterns) (map at-base (hash-ref cfg 'inputs '()))))
        (lambda () (for-each rm (find-files (list out) '("*.so"))) (write-forms script forms) c)
        'config (list forms c) 'needs (map at-base (hash-ref cfg 'needs '())) 'db-dir (absolute base (hash-ref cfg 'db-dir out))))
(define (cmake-project source dir . opts)
  (define cfg (check-opts opts '(cmake generator define toolchain prefix configuration inputs needs env targets jobs db-dir)))
  (define base (hash-ref (runtime-env) 'dir))
  (define src (absolute base source))
  (define out (absolute base dir))
  (define cmake (hash-ref cfg 'cmake "cmake"))
  (define configuration (hash-ref cfg 'configuration "Release"))
  (define prefix (and (hash-ref cfg 'prefix #f) (absolute base (hash-ref cfg 'prefix))))
  (define toolchain (and (hash-ref cfg 'toolchain #f) (absolute base (hash-ref cfg 'toolchain))))
  (define definitions
    (merge-opts (hash-ref cfg 'define (hash))
      (merge-opts (hash 'CMAKE_BUILD_TYPE configuration)
        (merge-opts (if prefix (hash 'CMAKE_INSTALL_PREFIX prefix) (hash)) (if toolchain (hash 'CMAKE_TOOLCHAIN_FILE toolchain) (hash))))))
  (define args
    (append (if (hash-ref cfg 'generator #f) (list "-G" (hash-ref cfg 'generator)) '())
            (map (lambda (k) (define v (hash-ref definitions k))
                   (~a "-D" k "=" (cond [(eq? v #t) "ON"] [(eq? v #f) "OFF"] [else (~a v)]))) (hash-keys definitions))))
  (define env (hash-ref cfg 'env (hash)))
  (define configure
    (step (build-path out "CMakeCache.txt")
          (lambda () (append (if (file-exists? (build-path src "CMakeLists.txt")) (list (build-path src "CMakeLists.txt")) '())
                             (hash-ref cfg 'inputs '()) (if toolchain (list toolchain) '())))
          (cmd 'env env $cmake -S $src -B $out @args)
          'needs (hash-ref cfg 'needs '()) 'db-dir (hash-ref cfg 'db-dir out)))
  (define targets (hash-ref cfg 'targets '()))
  (define build-args (append (if (null? targets) '() (cons "--target" targets))
                             (if (hash-ref cfg 'jobs #f) (list "--parallel" (~a (hash-ref cfg 'jobs))) '())))
  (step (string->symbol (~a "cmake-" (string-sha256 out))) (list configure)
        (append (list (cmd 'env env $cmake --build $out --config $configuration @build-args))
                (if prefix (list (cmd 'env env $cmake --install $out --config $configuration)) '()))
        'db-dir (hash-ref cfg 'db-dir out)))

(define-syntax (suite-form stx)
  (define (entry e)
    (unless (and (list? e) (>= (length e) 2) (identifier? (car e))) (syntax-error "expected [name action option value ...]" e))
    `(,(quote-syntax list) ,(symbol->string (syntax-e (car e))) ,(cadr e) ,@(cddr e)))
  (let loop ([parts (cdr stx)] [entries '()])
    (if (and (pair? parts) (list? (car parts)) (pair? (car parts)) (identifier? (caar parts)) (not (eq? (syntax-e (caar parts)) 'quote)))
        (loop (cdr parts) (cons (entry (car parts)) entries))
        `(,(quote-syntax suite) (,(quote-syntax list) ,@(reverse entries)) ,@parts))))
(define-syntax (test-suite stx) `(,(quote-syntax suite-form) ,@(cdr stx)))
(define-syntax (bench-suite stx) `(,(quote-syntax suite-form) ,@(cdr stx)))
(define (suite entries . opts)
  (define children (map (lambda (e) (hash 'name (~a (car e)) 'body (cadr e) 'options (suite-opts (cddr e)))) entries))
  (define names
    (map (lambda (e)
           (define name (hash-ref e 'name))
           (when (or (equal? name "") (glob-match? "*/*" name)) (error "suite entry name must be one path component" name))
           (string->symbol name))
         children))
  (unless (= (hash-count (foldl (lambda (name h) (hash-set h name #t)) (hash) names)) (length names)) (error "duplicate suite entry"))
  (hash 'kind 'suite 'children children 'options (suite-opts opts)))
(define (suite-opts opts) (check-opts opts '(tags needs defaults exit skip-exit target-ms warmup samples max-n)))
(define (diff expected actual . opts) (hash 'kind 'diff 'expected expected 'actual actual 'compare (hash-ref (check-opts opts '(compare)) 'compare #f)))
(define (batch execute . opts) (hash 'kind 'batch 'execute execute 'clock (hash-ref (check-opts opts '(clock)) 'clock 'reported)))
(define (measured c . opts) (hash 'kind 'measured 'command c 'clock (hash-ref (check-opts opts '(clock)) 'clock 'reported)))
(define (defer setup) (hash 'kind 'defer 'setup setup))
(define (kind v) (and (hash? v) (hash-ref v 'kind #f)))
(define (elapsed-ns start finish) (+ (* (- (car finish) (car start)) 1000000000) (- (cdr finish) (cdr start))))
(define (repeat n thunk) (let loop ([i n]) (unless (= i 0) (thunk) (loop (- i 1)))))
(define (cmd-status c extra)
  (unless (eq? (kind c) 'cmd) (error "expected cmd" c))
  (run-argv (append (hash-ref c 'directives) extra (list (cons 'check? #f))) (hash-ref c 'argv)))
(define (capture-file c path thread?) (cmd-status c (list (cons 'stdout path) (cons 'stderr (~a path ".stderr")) (cons 'thread? thread?))))
(define (test-status a dir)
  (cond
    [(procedure? a) (a) 0]
    [(eq? (kind a) 'cmd) (cmd-status a '())]
    [(eq? (kind a) 'diff)
     (define expected (build-path dir "expected.stdout"))
     (define actual (build-path dir "actual.stdout"))
     (define left (capture-file (hash-ref a 'expected) expected #f))
     (define right (capture-file (hash-ref a 'actual) actual #f))
     (cond
       [(or (not (= left 0)) (not (= right 0))) (displayln (~a "diff: commands must both succeed; exits " left ", " right)) 1]
       [(hash-ref a 'compare) (cmd-status ((hash-ref a 'compare) expected actual) '())]
       [else (if (equal? (file->string expected) (file->string actual)) 0 1)])]
    [else (error "expected cmd, diff or thunk" a)]))
(define (merge-suite-opts base extra)
  (foldl (lambda (k h) (define v (hash-ref extra k))
           (hash-set h k (cond [(member k '(tags needs)) (append (hash-ref h k '()) v)] [(eq? k 'defaults) (merge-opts (hash-ref h k (hash)) v)] [else v])))
         base (hash-keys extra)))
(define (flatten-suite suite)
  (unless (eq? (kind suite) 'suite) (error "expected test-suite or bench-suite"))
  (define (walk body name inherited own)
    (define opts (if (eq? (kind body) 'suite) (merge-suite-opts (hash-ref body 'options) own) own))
    (when (eq? (kind body) 'suite)
      (for-each (lambda (k) (unless (member k '(tags needs defaults)) (error "suite options are tags, needs and explicit child defaults" k))) (hash-keys opts)))
    (when (and (not (eq? (kind body) 'suite)) (hash-ref opts 'defaults #f)) (error "defaults belongs to a suite" name))
    (define effective (merge-suite-opts inherited opts))
    (define tags (hash-ref effective 'tags '()))
    (define needs (map ~a (hash-ref effective 'needs '())))
    (if (eq? (kind body) 'suite)
        (let ([defaults (merge-opts inherited (check-opts (hash-ref opts 'defaults (hash)) '(exit skip-exit target-ms warmup samples max-n)))])
          (apply append
            (map (lambda (e)
                   (define child (hash-ref e 'name))
                   (walk (hash-ref e 'body) (if (equal? name "") child (~a name "/" child)) (hash-with defaults 'tags tags 'needs needs) (hash-ref e 'options)))
                 (hash-ref body 'children))))
        (list (hash 'name name 'body body 'options (hash-set effective 'needs needs)))))
  (walk suite "" (hash) (hash)))
(define (under? name prefix)
  (or (equal? name prefix) (and (> (string-length name) (string-length prefix)) (equal? (substring name 0 (+ (string-length prefix) 1)) (~a prefix "/")))))
(define (matching entries name)
  (define matches (filter (lambda (e) (under? (hash-ref e 'name) name)) entries))
  (when (null? matches) (error "unknown test or suite" name))
  matches)
(define (bench-result a opts dir)
  (define (measure n)
    (define ns
      (cond
        [(procedure? a) (define start (current-time)) (repeat n a) (elapsed-ns start (current-time))]
        [(eq? (kind a) 'batch) ((hash-ref a 'execute) n)]
        [(eq? (kind a) 'measured)
         (define stage (scratch dir)) (define r (build-path stage "sample.sexp")) (define st (cmd-status ((hash-ref a 'command) n r) '()))
         (unless (= st 0) (error "benchmark command failed" st)) (define ns (read-sexp r)) (rm* stage) ns]
        [else (error "benchmark expects a thunk, batch or measured command factory")]))
    (unless (and (integer? ns) (>= ns 0)) (error "expected nonnegative batch duration in ns" ns))
    ns)
  (define target (* (hash-ref opts 'target-ms 50) 1000000))
  (define count (hash-ref opts 'samples 15))
  (define warmup (hash-ref opts 'warmup 3))
  (define max-n (hash-ref opts 'max-n 1073741824))
  (unless (and (> target 0) (> count 0) (>= warmup 0) (> max-n 0)) (error "invalid benchmark settings" opts))
  (define cal
    (let loop ([n 1] [samples '()])
      (define ns (measure n))
      (define next (cons (list n ns) samples))
      (cond [(>= ns target) (reverse next)]
            [(> n (quotient max-n 2)) (error "benchmark did not reach target time within max-n" n)]
            [else (loop (* n 2) next)])))
  (define n (car (list-ref cal (- (length cal) 1))))
  (define (sample count) (let loop ([i count] [values '()]) (if (= i 0) (reverse values) (loop (- i 1) (cons (measure n) values)))))
  (define warmups (sample warmup))
  (define samples (sample count))
  (define per-op (map (lambda (t) (quotient t n)) samples))
  (define ordered (sort per-op <))
  (define middle (quotient count 2))
  (hash 'n n 'target-ns target 'clock (if (procedure? a) 'wall (hash-ref a 'clock)) 'calibration cal 'warmup-ns warmups 'samples-ns samples 'ns/op per-op
        'min-ns (car ordered)
        'median-ns (if (= (modulo count 2) 1) (list-ref ordered middle) (quotient (+ (list-ref ordered (- middle 1)) (list-ref ordered middle)) 2))
        'p90-ns (list-ref ordered (- (quotient (+ (* 9 count) 9) 10) 1))))

(define (encode-report v)
  (cond [(hash? v) (cons 'zuokit-map (map (lambda (k) (list k (encode-report (hash-ref v k)))) (hash-keys v)))]
        [(list? v)
         (define content (map encode-report v))
         (if (and (pair? content) (member (car content) '(zuokit-map zuokit-list zuokit-pair))) (cons 'zuokit-list content) content)]
        [(pair? v) (list 'zuokit-pair (encode-report (car v)) (encode-report (cdr v)))]
        [else v]))
(define (decode-report v)
  (cond [(and (pair? v) (eq? (car v) 'zuokit-map)) (apply hash (apply append (map (lambda (p) (list (car p) (decode-report (cadr p)))) (cdr v))))]
        [(and (pair? v) (eq? (car v) 'zuokit-list)) (map decode-report (cdr v))]
        [(and (pair? v) (eq? (car v) 'zuokit-pair)) (cons (decode-report (cadr v)) (decode-report (list-ref v 2)))]
        [(list? v) (map decode-report v)] [else v]))
(define (load-suite manifest export config)
  (define decl (dynamic-require manifest export))
  (flatten-suite (if (procedure? decl) (decl config) decl)))
(define (suite-worker manifest export name mode dir)
  (define config (decode-report (read-sexp (build-path (path-only dir) "config.sexp"))))
  (define entries (load-suite manifest export config))
  (define e (car (filter (lambda (e) (equal? (hash-ref e 'name) name)) entries)))
  (define opts (hash-ref e 'options))
  (define a (let loop ([a (hash-ref e 'body)]) (if (eq? (kind a) 'defer) (loop ((hash-ref a 'setup))) a)))
  (define r
    (if (eq? mode 'bench) (hash-set (bench-result a opts dir) 'status 'passed)
        (let* ([code (test-status a dir)]
               [st (cond [(= code (hash-ref opts 'exit 0)) 'passed] [(equal? code (hash-ref opts 'skip-exit #f)) 'skipped] [else 'failed])])
          (hash 'status st 'exit code))))
  (write-sexp (build-path dir "result.sexp") (encode-report r)))
(define (suite-summaries records)
  (define names
    (foldl (lambda (record seen)
             (define parts (string-split (hash-ref record 'name) "/"))
             (let loop ([rest (cdr parts)] [prefix (car parts)] [seen seen])
               (if (null? rest) seen (loop (cdr rest) (~a prefix "/" (car rest)) (hash-set seen (string->symbol prefix) #t)))))
           (hash) records))
  (map (lambda (k)
         (define name (symbol->string k))
         (define statuses (map (lambda (r) (hash-ref r 'status)) (filter (lambda (r) (under? (hash-ref r 'name) name)) records)))
         (hash 'name name 'cases (length statuses) 'status
               (car (filter (lambda (s) (member s statuses)) '(error failed blocked passed skipped))))) (hash-keys names)))
(struct suite-state (results order))
(define (suite-run mode manifest opts)
  (define cfg (check-opts opts '(export names tags directory supervise config)))
  (define file (absolute (hash-ref (runtime-env) 'dir) manifest))
  (define export (hash-ref cfg 'export (if (eq? mode 'test) 'tests 'benchmarks)))
  (define config (hash-ref cfg 'config (hash)))
  (define entries (load-suite file export config))
  (define names (hash-ref cfg 'names '()))
  (define tags (hash-ref cfg 'tags '()))
  (for-each (lambda (name) (matching entries (~a name))) names)
  (define selected
    (filter (lambda (e)
              (and (or (null? names) (ormap (lambda (n) (under? (hash-ref e 'name) (~a n))) names))
                   (or (null? tags) (ormap (lambda (t) (member t (hash-ref (hash-ref e 'options) 'tags '()))) tags)))) entries))
  (define base (absolute (hash-ref (runtime-env) 'dir) (hash-ref cfg 'directory "build/zuokit")))
  (define dir (scratch base))
  (write-sexp (build-path dir "config.sexp") (encode-report config))
  (define library (quote-module-path))
  (define (visit e visiting state)
    (define name (hash-ref e 'name))
    (when (member name visiting) (error "cyclic suite dependency" (reverse (cons name visiting))))
    (if (hash-ref (suite-state-results state) (string->symbol name) #f) state
        (let* ([required (apply append (map (lambda (need) (matching entries need)) (hash-ref (hash-ref e 'options) 'needs '())))]
               [ready (foldl (lambda (e s) (visit e (cons name visiting) s)) state required)]
               [prerequisites (map (lambda (e) (hash-ref (suite-state-results ready) (string->symbol (hash-ref e 'name)))) required)]
               [blocked? (ormap (lambda (r) (not (eq? (hash-ref r 'status) 'passed))) prerequisites)]
               [case-dir (build-path dir (~a (length (suite-state-order ready))))])
          (mkdir case-dir)
          (define r
            (if blocked?
                (hash 'status 'blocked)
                (let* ([argv (list (hash-ref (runtime-env) 'exe) library "worker" file (~a export) name (~a mode) case-dir)]
                       [c (if (hash-ref cfg 'supervise #f) ((hash-ref cfg 'supervise) argv) (make-command '() argv))]
                       [start (current-time)]
                       [st (cmd-status c (list (cons 'stdout (build-path case-dir "stdout")) (cons 'stderr (build-path case-dir "stderr"))))])
                  (define path (build-path case-dir "result.sexp"))
                  (hash-set (cond [(not (= st 0)) (hash 'status 'error 'worker-exit st)]
                                  [(not (file-exists? path)) (hash 'status 'error 'reason "worker did not publish a result")]
                                  [else (decode-report (read-sexp path))])
                    'worker-wall-ns (elapsed-ns start (current-time))))))
          (define record (hash-with r 'name name 'directory case-dir))
          (suite-state (hash-set (suite-state-results ready) (string->symbol name) record) (cons record (suite-state-order ready))))))
  (define completed (foldl (lambda (e state) (visit e '() state)) (suite-state (hash) '()) selected))
  (define records (reverse (suite-state-order completed)))
  (define r (hash 'version 1 'zuo-version (list (hash-ref (runtime-env) 'version) (hash-ref (runtime-env) 'minor-version))
                  'mode mode 'manifest file 'directory dir 'cases records 'suites (suite-summaries records)
                  'exit-code (if (andmap (lambda (r) (member (hash-ref r 'status) '(passed skipped))) records) 0 1)))
  (write-sexp (build-path dir "report.sexp") (encode-report r))
  r)
(define (test-run manifest . options) (suite-run 'test manifest options))
(define (bench-run manifest . options) (suite-run 'bench manifest options))
(define (suite-targets manifest . opts)
  (define cfg (check-opts opts '(mode export config inputs db-dir directory supervise groups cases?)))
  (define mode (hash-ref cfg 'mode 'test))
  (define file (absolute (hash-ref (runtime-env) 'dir) manifest))
  (define export (hash-ref cfg 'export (if (eq? mode 'test) 'tests 'benchmarks)))
  (define config (hash-ref cfg 'config (hash)))
  (define entries (load-suite file export config))
  (define selectors
    (foldl (lambda (name h) (hash-set h (string->symbol name) (hash 'names (list name))))
           (hash) (if (hash-ref cfg 'cases? #t)
                      (append (map (lambda (e) (hash-ref e 'name)) entries)
                              (map (lambda (s) (hash-ref s 'name)) (suite-summaries (map (lambda (e) (hash-set e 'status 'passed)) entries)))) '())))
  (define groups (hash-ref cfg 'groups (hash (if (eq? mode 'test) 'check 'bench) (hash))))
  (for-each (lambda (k) (when (hash-ref selectors k #f) (error "suite target name collision" k))) (hash-keys groups))
  (define all (merge-opts selectors groups))
  (map (lambda (name)
         (define selection (check-opts (hash-ref all name) '(names tags)))
         (step name (cons file (hash-ref cfg 'inputs '()))
               (lambda ()
                 (define r
                   (suite-run mode file
                     (merge-opts (hash 'export export 'config config 'directory (hash-ref cfg 'directory "build/zuokit")
                                       'supervise (hash-ref cfg 'supervise #f)) selection)))
                 (report r)
                 (unless (= (hash-ref r 'exit-code) 0) (error "suite failed" name)))
               'db-dir (hash-ref cfg 'db-dir "build"))) (hash-keys all)))
(define (format-duration ns)
  (define unit (cond [(>= ns 1000000000) (cons 1000000000 "s")] [(>= ns 1000000) (cons 1000000 "ms")] [(>= ns 1000) (cons 1000 "us")] [else (cons 1 "ns")]))
  (define scaled (quotient (* ns 1000) (car unit)))
  (define fraction (~a (+ 1000 (modulo scaled 1000))))
  (~a (quotient scaled 1000) "." (substring fraction 1 4) " " (cdr unit)))
(define (report r)
  (for-each (lambda (r)
    (displayln (~a (hash-ref r 'status) "  " (hash-ref r 'name)
      (if (hash-ref r 'median-ns #f)
          (~a "  median " (format-duration (hash-ref r 'median-ns)) ", min " (format-duration (hash-ref r 'min-ns))
              ", p90 " (format-duration (hash-ref r 'p90-ns)) ", N=" (hash-ref r 'n) ", clock=" (hash-ref r 'clock))
          ""))))
    (hash-ref r 'cases))
  (displayln (string-join
               (map (lambda (st) (~a st "=" (length (filter (lambda (r) (eq? (hash-ref r 'status) st)) (hash-ref r 'cases)))))
                    '(passed failed error skipped blocked)) " "))
  (displayln (~a "Report: " (build-path (hash-ref r 'directory) "report.sexp"))))

(module+ main
  (define args (hash-ref (runtime-env) 'args))
  (unless (>= (length args) 2) (error "usage: zuo zuokit.zuo {upgrade|test|bench} <manifest.zuo> [name ...]"))
  (define op (car args))
  (define manifest (absolute (hash-ref (runtime-env) 'dir) (cadr args)))
  (cond
    [(equal? op "worker")
     (unless (= (length args) 6) (error "invalid worker arguments"))
     (suite-worker manifest (string->symbol (list-ref args 2)) (list-ref args 3) (string->symbol (list-ref args 4)) (list-ref args 5))]
    [(equal? op "upgrade")
     (void (deps-upgrade (dynamic-require manifest 'dependencies) "build/_deps" 'base (path-only manifest)
                         'names (if (null? (cddr args)) #t (map string->symbol (cddr args)))))]
    [(member op '("test" "bench"))
     (define r (suite-run (string->symbol op) manifest (list 'names (cddr args))))
     (report r)
     (exit (hash-ref r 'exit-code))]
    [else (error "unknown operation" op)]))
